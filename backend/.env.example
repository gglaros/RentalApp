# Αντίγραψε στο .env (στον φάκελο rentalApp/ για Docker) και βάλε δικές σου τιμές.

# ---- περιβάλλον: development | production | testing ----
APP_ENV=development
FLASK_DEBUG=1

# ---- βάση (PostgreSQL) ----
POSTGRES_USER=myuser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rentaldb
POSTGRES_HOST=localhost      # στο Docker το backend παίρνει "db" από το docker-compose
POSTGRES_PORT=5432
# εναλλακτικά, ένα URL για όλα (π.χ. για tests): DATABASE_URL=sqlite:///test.db

# ---- JWT ----
# φτιάξε ένα με: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_EXPIRES_MINUTES=60

# ---- CORS: διευθύνσεις του frontend, χωρισμένες με κόμμα ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- uploads ----
MAX_UPLOAD_MB=50
